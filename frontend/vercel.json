{
  "version": 2,
  "buildCommand": "chmod -R +x node_modules/.bin && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/efhub",
      "destination": "https://efhub.com/api/public/coaches"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
