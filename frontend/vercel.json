{
  "version": 2,
  "buildCommand": "chmod -R +x node_modules/.bin && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/upload.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/upload",
      "dest": "/api/upload.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
